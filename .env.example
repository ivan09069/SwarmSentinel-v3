# Groq API (free tier - https://console.groq.com/keys)
GROQ_API_KEY=gsk_...                # Required - get free key at console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile  # Or: llama-3.1-70b-versatile, mixtral-8x7b-32768

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Runtime config
SIM_MODE=True                       # Set False when live
POLL_INTERVAL=60                    # Seconds between cycles
